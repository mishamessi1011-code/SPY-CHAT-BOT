# ── Обязательно ──
# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here
# Ваш Telegram ID (узнать: @userinfobot). Сюда приходят бэкапы, ошибки, оплаты. Несколько — через запятую
ADMIN_IDS=123456789

# ── Хранилище (должно быть на ПОСТОЯННОМ диске!) ──
DB_PATH=data/bot_archive.db
MEDIA_DIR=data/media

# ── Премиум ──
PREMIUM_PRICE=100          # цена в Telegram Stars
PREMIUM_DAYS=30            # на сколько дней
SUPPORT_CONTACT=@your_username   # куда писать по вопросам оплаты (/paysupport)

# ── Данные ──
RETENTION_DAYS=30          # через сколько дней удалять все сообщения и медиа
MEDIA_QUOTA_MB=500         # лимит медиа на одного пользователя
MAX_DOWNLOAD_MB=20         # больше 20 Telegram ботам не отдаёт

# ── Время ──
TIMEZONE=Asia/Tashkent
BACKUP_HOUR=4              # во сколько присылать бэкап базы админам
CLEANUP_HOUR=5             # во сколько удалять старые данные
